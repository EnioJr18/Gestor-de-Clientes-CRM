# Ambiente local padrao.
DJANGO_SETTINGS_MODULE=config.settings.development

# Docker Compose local. Sao valores de desenvolvimento, nao credenciais reais.
POSTGRES_DB=crm_pro
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_TEST_DB=crm_pro_test
FRONTEND_PORT=8080

# Desenvolvimento.
SECRET_KEY=chave-local-de-exemplo
DEBUG=True
USE_SQLITE=False
DATABASE_URL=postgresql://crm_user:change-me-local-only@localhost:5432/crm_pro
TEST_DATABASE_URL=postgresql://crm_user:change-me-local-only@localhost:5432/crm_pro_test
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPA_ENABLED=False

# JWT para SPA. O access token fica em memoria no cliente; o refresh e HttpOnly.
JWT_REFRESH_COOKIE_NAME=crm_refresh
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_LOGIN_THROTTLE_RATE=5/min
JWT_REFRESH_THROTTLE_RATE=20/min
JWT_CSRF_THROTTLE_RATE=60/min

# Cache local para desenvolvimento. Em producao multi-processo/replica, configure
# um backend compartilhado e ative REQUIRE_SHARED_THROTTLE_CACHE.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=crm-pro
CACHE_TIMEOUT=300

# HTTPS/cookies locais devem permanecer desligados.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# E-mail local.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CRM.Pro <no-reply@example.com>

# Fallback local de diagnostico, nao recomendado como padrao.
# USE_SQLITE=True
# USE_SQLITE_FOR_TESTS=True

