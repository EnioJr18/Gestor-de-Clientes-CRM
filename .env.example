# Ambiente local padrao.
DJANGO_SETTINGS_MODULE=config.settings.development

# Desenvolvimento.
SECRET_KEY=chave-local-de-exemplo
DEBUG=True
USE_DATABASE_URL=False
DATABASE_URL=sqlite:///backend/db.sqlite3
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# HTTPS/cookies locais devem permanecer desligados.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# E-mail local.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CRM.Pro <no-reply@example.com>

# Producao: definir no provedor de deploy, sem valores reais no repositorio.
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=
# DEBUG=False
# DATABASE_URL=
# DATABASE_CONN_MAX_AGE=600
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=
